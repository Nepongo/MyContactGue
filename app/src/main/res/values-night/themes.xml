<!-- res/values-night/themes.xml -->
<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- Base application theme. -->
    <style name="Theme.MyContactGue" parent="Theme.Material3.DayNight.NoActionBar">
        <!-- Primary brand color. -->
        <item name="colorPrimary">@color/modern_blue</item>
        <item name="colorOnPrimary">@color/white</item>
        <item name="colorPrimaryContainer">@color/modern_blue_dark</item>
        <item name="colorOnPrimaryContainer">@color/white</item>
        
        <!-- Secondary brand color. -->
        <item name="colorSecondary">@color/modern_blue_light</item>
        <item name="colorOnSecondary">@color/white</item>
        
        <!-- Background and surface colors -->
        <item name="android:windowBackground">@color/dark_gray</item>
        <item name="colorSurface">@color/dark_gray</item>
        <item name="colorOnSurface">@color/white</item>
        <item name="colorOutline">@color/light_gray</item>

        <!-- Status bar and Navigation bar -->
        <item name="android:statusBarColor">@color/black</item>
        <item name="android:navigationBarColor">@color/black</item>
    </style>
</resources>