<!-- res/values/themes.xml -->
<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- Base application theme. -->
    <style name="Theme.MyContactGue" parent="Theme.Material3.DayNight.NoActionBar">
        <!-- Primary brand color. -->
        <item name="colorPrimary">@color/modern_blue</item>
        <item name="colorOnPrimary">@color/white</item>
        <item name="colorPrimaryContainer">@color/soft_blue_bg</item>
        <item name="colorOnPrimaryContainer">@color/modern_blue_dark</item>
        
        <!-- Secondary brand color. -->
        <item name="colorSecondary">@color/modern_blue</item>
        <item name="colorOnSecondary">@color/white</item>
        
        <!-- Accent color -->
        <item name="colorAccent">@color/modern_blue</item>
        
        <!-- Background and surface colors -->
        <item name="android:windowBackground">@color/off_white</item>
        <item name="colorSurface">@color/off_white</item>
        <item name="colorOnSurface">@color/dark_gray</item>
        <item name="colorOutline">@color/color_outline</item>
        <item name="colorSurfaceVariant">@color/soft_blue_bg</item>

        <!-- Status bar and Navigation bar -->
        <item name="android:statusBarColor">@color/modern_blue</item>
        <item name="android:navigationBarColor">@color/white</item>

        <!-- No more default purple! -->
        <item name="colorPrimaryVariant" tools:targetApi="l">@color/modern_blue_dark</item>
        <item name="colorSecondaryVariant">@color/modern_blue_dark</item>
    </style>

    <style name="CircleImageView" parent="">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">50%</item>
    </style>
</resources>